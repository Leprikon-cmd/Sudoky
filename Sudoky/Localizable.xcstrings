    "about.mastery.clues" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The generator aims to hide 28 cells for Beginner, 38 for Student, 46 for Master, and 54 for both Sensei and Dokushin. It preserves a unique solution, so a puzzle may end up with fewer hidden cells than the target."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Генератор стремится скрыть 28 чисел у Новичка, 38 у Ученика, 46 у Мастера и 54 у Сенсея и Dokushin. Он сохраняет единственное решение, поэтому иногда скрытых клеток получается меньше цели."
          }
        }
      }
    },
