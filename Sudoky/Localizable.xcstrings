    "about.howToPlay.chooseDifficulty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Choose a difficulty from Beginner to Sensei. Modes differ in the number of hidden digits and lives — your chances to make a mistake; hints are also available."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Выберите уровень сложности от «Новичка» до Сенсея. Режимы отличаются количеством скрытых цифр и количеством \"жизней\" — то есть шансов на ошибку и невнимательность, тут есть подсказки."
          }
        }
      }
    },
    "about.howToPlay.dokushin" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Dokushin is a challenge to yourself: no mistakes allowed and no hints through number highlighting."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Режим \"Докушин\" — это вызов самому себе: без права на ошибку, без подсказок в виде подсветки цифр."
          }
        }
      }
    },
    "about.howToPlay.points" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Points are awarded for speed, a clean completion, and the selected difficulty."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Очки начисляются за скорость, чистоту прохождения и выбранную сложность."
          }
        }
      }
    },
    "about.howToPlay.saved" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Progress is saved, so you can always return to your game."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Прогресс сохраняется — вы всегда можете вернуться к своей партии."
          }
        }
      }
    },
