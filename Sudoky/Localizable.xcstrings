    "about.sudokuHistory.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudoku was not invented by Nikoli. The publisher found the puzzle in an American magazine under the name Number Place and introduced it to readers in Japan in 1984. Its first title was “Suuji wa dokushin ni kagiru,” roughly, “the numbers must remain single.” It was later shortened to Sudoku. In 1986, Nikoli adopted symmetrical clue patterns as a rule for constructing puzzles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Судоку придумала не Nikoli: издатель нашёл головоломку в американском журнале под названием Number Place и представил её читателям в Японии в 1984 году. Сначала она называлась «Suuji wa dokushin ni kagiru» — примерно «числа должны оставаться одиночными». Позже название сократили до Sudoku. В 1986 году Nikoli ввела симметричное расположение подсказок как правило составления головоломок."
          }
        }
      }
    },
    "about.sudokuHistory.source" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Source: Nikoli"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник: Nikoli"
          }
        }
      }
    },
    "about.support.thanks" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you ever choose to thank the author, please do so freely and only when it feels right to you. Playing the game, sharing a kind word, or recommending it is already a generous gesture. There is nothing you need to do now; the game remains free and has no advertising."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если когда-нибудь вы захотите поблагодарить автора, пусть это будет только по вашему желанию и в подходящий для вас момент. Сыграть, сказать доброе слово или порекомендовать игру — уже щедрый жест. Сейчас ничего делать не нужно; игра остаётся бесплатной и без рекламы."
          }
        }
      }
    },
