    "garden.help.continuation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continued"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжение"
          }
        }
      }
    },
    "garden.help.developmentSteps.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solving sudoku builds experience and increases your internal player level. Experience and level numbers are not displayed. Each new level grants one garden development step. Steps become available as experience accumulates, not after every individual win. If you reach several new levels, the garden receives the same number of development steps. Levels already counted do not grant them again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Решая судоку, вы накапливаете опыт и повышаете внутренний уровень игрока. Числовые показатели опыта и уровня не отображаются. Каждый новый уровень даёт одну ступень развития сада. Она появляется по мере накопления опыта, а не после каждой отдельной победы. Если достигнуто несколько новых уровней, сад получит столько же ступеней развития. Уже учтённые уровни повторно их не дают."
          }
        }
      }
    },
    "garden.help.developmentSteps.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Development Steps"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ступени развития"
          }
        }
      }
    },
    "garden.help.growingByHand.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trees do not grow automatically. Select a tree and tap ‘Grow’: one development step advances it by one growth stage. Each tree has 10 stages. Growing is unavailable when you have no steps left or the tree is at its final stage."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деревья не растут автоматически. Выберите дерево и нажмите „Взрастить“: одна ступень развития повышает его стадию роста на одну. У каждого дерева 10 стадий. Без запаса ступеней или на последней стадии выращивание недоступно."
          }
        }
      }
    },
    "garden.help.growingByHand.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Growing by Hand"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ручное выращивание"
          }
        }
      }
    },
    "garden.help.oneTreePerSpecies.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each of the five species can be planted only once: oak, beech, maple, juniper, and apple. Stone decorations are not available yet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый из пяти видов можно посадить только один раз: дуб, бук, клён, можжевельник и яблоню. Украшение камнями пока недоступно."
          }
        }
      }
    },
    "garden.help.oneTreePerSpecies.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One Tree per Species"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один вид — одно дерево"
          }
        }
      }
    },
    "garden.help.pageIndicator" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page %1$d of %2$d"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страница %1$d из %2$d"
          }
        }
      }
    },
    "garden.help.planting.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose one of the five species in the garden and tap “Plant”. A species that is already planted cannot be planted again. The first tree appears at growth stage one; planting each additional species uses one saved development step."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите один из пяти видов в саду и нажмите „Посадить“. Уже посаженный вид повторно выбрать нельзя. Первое дерево появляется на первой стадии роста, посадка следующего вида расходует одну накопленную ступень развития."
          }
        }
      }
    },
    "garden.help.planting.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planting"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посадка"
          }
        }
      }
    },
    "garden.help.savingSteps.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unused development steps are saved, so you can collect them and spend them later. They do not expire, even when a tree is fully grown. Losing a game does not take away earned experience or development steps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неиспользованные ступени развития сохраняются — их можно копить и тратить позже. Они не сгорают, даже если дерево уже полностью выросло. Проигрыш не отнимает накопленный опыт или ступени развития."
          }
        }
      }
    },
    "garden.help.savingSteps.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saving Steps"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Накопление"
          }
        }
      }
    },
    "garden.help.swipeHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe to turn pages"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните, чтобы перелистнуть"
          }
        }
      }
    },
    "garden.help.switchingTrees.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All five species appear in a horizontal row in the garden. Select a planted tree or an empty slot to view it; you can also swipe horizontally across the tree to move between slots. Selecting a planted tree also selects it on the home screen; viewing an empty slot leaves the home tree unchanged. “Grow” affects only the selected planted tree."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В саду все пять видов расположены в горизонтальном ряду: выберите посаженное дерево или пустой вид, чтобы посмотреть его. Горизонтальный свайп по дереву также переключает позиции. При выборе посаженного дерева оно становится текущим и на главном экране; просмотр пустого слота не меняет дерево там. „Взрастить“ действует только на выбранное посаженное дерево."
          }
        }
      }
    },
    "garden.help.switchingTrees.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching Trees"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключение деревьев"
          }
        }
      }
    },
    "garden.help.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How the Sage’s Garden Works"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как устроен сад мудреца"
          }
        }
      }
    },
