      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This project is a path: a non-commercial game made out of love for silence, numbers, and harmony."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот проект — путь. Это некоммерческая игра, созданная из любви к тишине, числам и гармонии."
          }
        }
      }
    },
    "about.description.free" : {
