    "about.privacy.offline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game works offline. Your progress and preferences are saved only on your device. A future voluntary thank-you through Apple will require an internet connection."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра работает офлайн. Прогресс и настройки сохраняются только на вашем устройстве. Будущая добровольная благодарность через Apple потребует подключения к интернету."
          }
        }
      }
    },
    "about.privacy.permissions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app requests no system permissions. Game data and preferences are stored locally on your device."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
